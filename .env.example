# GCP
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI Agent Platform
VERTEX_AI_MODEL=gemini-2.5-pro

# OpenTelemetry → Collector → Dynatrace
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Api-Token YOUR_DT_API_TOKEN

# Dynatrace API (for Self-Observability Loop)
DYNATRACE_TENANT_URL=https://your-env.live.dynatrace.com
DYNATRACE_API_TOKEN=dt0c01.YOUR_TOKEN_WITH_FETCHDATA
